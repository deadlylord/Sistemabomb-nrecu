// PROTOTYPE FOR EMULATOR TESTS ONLY. This is not a complete POS ruleset.
// Assumptions: a trusted server issues identityVersion=1 custom claims with
// sellerId/companyId/storeId/roleId; clients cannot write sellers, roles or
// companies under this standalone ruleset. Current anonymous POS login does
// not satisfy these assumptions. Do not deploy this file over the live POS.
// Source records and projection entries have companyId:string, storeId:string.
// Projection summaries are server-owned; all client writes are denied.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && request.auth.token.identityVersion == 1;
    }
    function seller() {
      return get(/databases/$(database)/documents/sellers/$(request.auth.token.sellerId)).data;
    }
    function role() {
      return get(/databases/$(database)/documents/roles/$(request.auth.token.roleId)).data;
    }
    function liveIdentity(companyId) {
      return verified() && request.auth.token.companyId == companyId
        && seller().get('isDisabled', false) == false
        && seller().companyId == companyId
        && seller().storeId == request.auth.token.storeId
        && seller().roleId == request.auth.token.roleId
        && role().companyId == companyId
        && role().get('isDisabled', false) == false
        && get(/databases/$(database)/documents/companies/$(companyId)).data.get('isDisabled', false) == false
        && !(get(/databases/$(database)/documents/companies/$(companyId)).data.get('status', 'active') in ['inactive', 'suspended']);
    }
    function canReadStore(companyId, storeId) {
      return liveIdentity(companyId)
        && get(/databases/$(database)/documents/stores/$(storeId)).data.companyId == companyId
        && get(/databases/$(database)/documents/stores/$(storeId)).data.get('isDisabled', false) == false
        && (storeId == request.auth.token.storeId || role().userType == 'admin')
        && ('financial_reconciliation' in role().permissions || 'accounting' in role().permissions);
    }
    match /financialLedgerCompanies/{companyId}/stores/{storeId}/{detail=**} {
      allow read: if canReadStore(companyId, storeId);
      allow write: if false;
    }
    match /financialRecords/{recordId} {
      allow read: if canReadStore(resource.data.companyId, resource.data.storeId);
      allow write: if false;
    }
    // No overlapping authenticated catch-all: it would override the denials.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
