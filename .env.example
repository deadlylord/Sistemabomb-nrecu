# Copy to .env.local for local development. Never commit real credentials.
VITE_APP_ENV=development
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_PORT=9099
VITE_STORAGE_EMULATOR_PORT=9199

# Use a non-production/demo config locally. Emulator traffic stays local.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-vestika.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-vestika
VITE_FIREBASE_STORAGE_BUCKET=demo-vestika.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

# Set this in Netlify contexts too. It activates the guard against accidental production access.
VITE_FIREBASE_PRODUCTION_PROJECT_ID=factura2-6e811
